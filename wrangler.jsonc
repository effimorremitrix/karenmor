{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "karenmor",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-19",
  "observability": { "enabled": true },

  // `directory` is intentionally omitted — the Vite plugin populates it from
  // the client build output. Setting it by hand breaks that.
  //
  // `run_worker_first` is load-bearing: with SPA `not_found_handling`, a
  // request that matches no asset is answered with index.html WITHOUT invoking
  // the Worker. Without this, POST /api/contact would return the HTML shell
  // with a 200, the form would show its success toast, and every submission
  // would be silently discarded.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karenmor-contact",
      "database_id": "ca463683-1505-42c6-bde1-3f6b9b61426f",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "CONTACT_TO_EMAIL": "info@karenmor.com",
    "CONTACT_FROM_EMAIL": "אתר קרן מור <website@karenmor.com>"
  }
}
